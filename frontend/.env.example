# ---------------------------------------------------------------------------
# Copy to `.env.local` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend, used by server components.
API_BASE_URL=http://localhost:8000

# Public site URL — used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prefix of the API as seen from the browser. `/api/*` is proxied to the
# backend by next.config.mjs in development.
NEXT_PUBLIC_API_PREFIX=/api/v1