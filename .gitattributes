# Normalise line endings in the repository itself so diffs are stable and CI
# behaves identically on Linux, macOS and Windows.
* text=auto eol=lf

# Windows scripts must keep CRLF or cmd.exe refuses to parse them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF even on Windows (Git Bash / WSL).
*.sh text eol=lf

# Lockfiles are large and noisy; keep them out of diffs but never rewrite them.
frontend/package-lock.json -diff linguist-generated=true

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.mp4 binary