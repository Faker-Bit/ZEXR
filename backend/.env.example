# ---------------------------------------------------------------------------
# ZEXR Deal Hub API — environment template.
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- application
ENVIRONMENT=local
DEBUG=true
APP_NAME=ZEXR Deal Hub API
APP_VERSION=1.0.0
SITE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------- database
# PostgreSQL in production. SQLite works for local development.
# DATABASE_URL=postgresql+psycopg://zexrdealhub:password@localhost:5432/zexrdealhub
DATABASE_URL=sqlite:///./zexrdealhub.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# -------------------------------------------------------------------- secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying-0123456789abcdefghijklmnop
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_NAME=zexrdealhub_token
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------ redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=120
CACHE_ENABLED=true

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------ discovery
# Master switch. When false the crawler refuses every outbound request.
DISCOVERY_ENABLED=true
DISCOVERY_USER_AGENT=ZEXR Deal HubBot/1.0 (+https://zexrdealhub.com/bot; respects robots.txt)
DISCOVERY_DEFAULT_TIMEOUT=20
DISCOVERY_DEFAULT_RATE_LIMIT_PER_HOUR=30
DISCOVERY_CACHE_TTL_SECONDS=900
DISCOVERY_MAX_RETRIES=3
# Everything discovered lands in review unless this is explicitly enabled.
DISCOVERY_AUTO_PUBLISH=false
DISCOVERY_ALLOW_PAYWALLED=false

# --------------------------------------------------------------- verification
VERIFY_ENABLED=true
VERIFY_INTERVAL_HOURS=12
VERIFY_BROKEN_LINK_THRESHOLD=3

# In-process scheduler. Disable when Celery beat owns the schedule in production.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=240/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_SEARCH=90/minute
RATE_LIMIT_WRITE=30/minute

# ------------------------------------------------------------ email delivery
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@zexrdealhub.com

# --------------------------------------------------------------------- oauth
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --------------------------------------------------------- source credentials
# API keys are read from the environment using the name stored on each source
# row (`api_key_env`). Keys are never stored in the database.
AFFILIATE_NETWORK_API_KEY=

# ---------------------------------------------------------------- billing
# Free tier sees BILLING_FREE_OFFER_LIMIT offers per listing; Pro sees all.
BILLING_ENABLED=true
BILLING_FREE_OFFER_LIMIT=12
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=7
# Fallback prices when a provider price/plan id is not configured (cents / paise).
PRO_PRICE_MONTHLY_USD=500
PRO_PRICE_MONTHLY_INR=44900

# Stripe - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Razorpay - https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=