# --------------------------------------------------------------- Database
# Local SQLite files are regenerable: `python -m app.db.seed`
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# -------------------------------------------------------------- Environment
# Real .env files hold credentials and must never be committed.
# The *.example templates are tracked deliberately.
.env
.env.*
!.env.example
!**/.env.example
*.local

# --------------------------------------------------------- Keys & secrets
*.pem
*.key
id_rsa*
id_ed25519*
credentials.json
service-account*.json

