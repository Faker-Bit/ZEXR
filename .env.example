# ---------------------------------------------------------------------------
# Local development environment for docker compose.
# Copy to `.env` before running `docker compose up`.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string-before-deploying

POSTGRES_PASSWORD=replace-me
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Discovery: the crawler honours robots.txt and per-source rate limits.
# Nothing is auto-published — everything lands in the review queue.
DISCOVERY_ENABLED=true
DISCOVERY_AUTO_PUBLISH=false

# Set false when running the `celery` profile (beat owns the schedule).
SCHEDULER_ENABLED=true

EMAIL_BACKEND=console
EMAIL_FROM=no-reply@zexrdealhub.com

OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AFFILIATE_NETWORK_API_KEY=